          "description" : "True when more options meet every limit than are listed",
          "type" : "boolean"
        },
        "nextStep" : {
          "type" : "string"
        },
        "optionLimit" : {
          "format" : "int32",
          "type" : "integer"
        },
        "options" : {
          "description" : "Options that meet every limit, cheapest first",
          "items" : {
            "properties" : {
              "additionalCost" : {
                "$ref" : "#/$defs/Money",
                "description" : "What the customer pays: the price difference plus shipping"
              },
              "arrives" : {
                "format" : "date",
                "type" : "string"
              },
              "method" : {
                "type" : "string"
              },
              "priceDifference" : {
                "$ref" : "#/$defs/Money"
              },
              "quoteExpiresAt" : {
                "format" : "date-time",
                "type" : "string"
              },
              "quoteId" : {
                "type" : "string"
              },
              "shipping" : {
                "$ref" : "#/$defs/Money"
              },
              "shipsFrom" : {
                "type" : "string"
              },
              "warehouseId" : {
                "type" : "string"
              }
            },
            "required" : [ "additionalCost", "arrives", "method", "priceDifference", "quoteExpiresAt", "quoteId", "shipping", "shipsFrom", "warehouseId" ],
            "type" : "object"
          },
          "type" : "array"
        },
        "optionsMeetingLimits" : {
          "format" : "int32",
          "type" : "integer"
        },
        "orderReference" : {
          "type" : "string"
        },
        "outcome" : {
          "description" : "options_available, no_matching_option, ineligible, needs_clarification, item_not_found, order_not_found, or invalid_request",
          "type" : "string"
        },
        "quotedOptions" : {
          "format" : "int32",
          "type" : "integer"
        },
        "rejectedOptions" : {
          "description" : "The closest options that miss a limit, with what each one misses",
          "items" : {
            "properties" : {
              "additionalCost" : {
                "$ref" : "#/$defs/Money"
              },
              "arrives" : {
                "format" : "date",
                "type" : "string"
              },
              "method" : {
                "type" : "string"
              },
              "misses" : {
                "items" : {
                  "properties" : {
                    "actual" : {
                      "type" : "string"
                    },
                    "constraint" : {
                      "description" : "deadline or cost_limit",
                      "type" : "string"
                    },
                    "limit" : {
                      "type" : "string"
                    }
                  },
                  "required" : [ "actual", "constraint", "limit" ],
                  "type" : "object"
                },
                "type" : "array"
              },
              "quoteId" : {
                "type" : "string"
              },
              "shipsFrom" : {
                "type" : "string"
              },
              "warehouseId" : {
                "type" : "string"
              }
            },
            "required" : [ "additionalCost", "arrives", "method", "misses", "quoteId", "shipsFrom", "warehouseId" ],
            "type" : "object"
          },
          "type" : "array"
        },
        "replacement" : {
          "$ref" : "#/$defs/Replacement"
        },
        "stock" : {
          "items" : {
            "properties" : {
              "available" : {
                "format" : "int32",
                "type" : "integer"
              },
              "shipsFrom" : {
                "type" : "string"
              },
              "warehouseId" : {
                "type" : "string"
              }
            },
            "required" : [ "available", "shipsFrom", "warehouseId" ],
