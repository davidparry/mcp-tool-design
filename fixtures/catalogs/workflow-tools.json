    "name" : "submit_exchange",
    "title" : "Submit an exchange",
    "description" : "Submit one exchange quote from preview_exchange after the customer explicitly approves that option. Commits the exchange, takes the replacement from stock, and charges the additional cost. The quote is checked again first: an expired quote, missing stock, or an item that can no longer be exchanged is refused with the reason, and nothing is committed. Submitting the same quote again returns the original exchange and changes nothing.",
    "inputSchema" : {
      "$schema" : "https://json-schema.org/draft/2020-12/schema",
      "properties" : {
        "quoteId" : {
          "description" : "The quoteId of the option the customer approved, such as EQ-5001",
          "type" : "string"
        }
      },
      "required" : [ "quoteId" ],
      "type" : "object"
    },
    "outputSchema" : {
