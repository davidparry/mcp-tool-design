          "required" : [ "amount", "currency" ],
          "type" : "object"
        },
        "estimatedArrival" : {
          "format" : "date",
          "type" : "string"
        },
        "exchangeId" : {
          "type" : "string"
        },
        "itemId" : {
          "type" : "string"
        },
        "message" : {
          "type" : "string"
        },
        "method" : {
          "type" : "string"
        },
        "nextStep" : {
          "type" : "string"
        },
        "orderReference" : {
          "type" : "string"
        },
        "outcome" : {
          "description" : "submitted, already_submitted, quote_expired, stock_unavailable, ineligible, quote_not_found, or invalid_request",
          "type" : "string"
        },
        "quantity" : {
          "format" : "int32",
          "type" : "integer"
        },
        "quoteId" : {
          "type" : "string"
        },
        "replacementSku" : {
          "type" : "string"
        },
        "status" : {
          "type" : "string"
