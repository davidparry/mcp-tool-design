{
  "sha256" : "585bb142a3710f2be098f14b047f16a5fb65164250df348008b35ba28dd35cae",
  "tools" : [ {
    "name" : "preview_exchange",
    "title" : "Preview an exchange",
    "description" : "Find and price replacements for an item in an order. Matches the item from the customer's description, checks that it can be exchanged, finds the replacement in the size and color asked for, and quotes every in-stock warehouse and delivery method against the delivery deadline and cost limit. Returns an explicit outcome, up to 3 options that meet every limit (cheapest first) with quote IDs, and the closest options that don't, with the limit each one misses. Creates draft quotes that expire in 30 minutes. It never submits an exchange, reserves stock, or charges the customer.",
    "inputSchema" : {
      "$schema" : "https://json-schema.org/draft/2020-12/schema",
      "properties" : {
        "costLimit" : {
          "description" : "The most the customer will pay on top of what they paid: the price difference plus shipping. \"No extra cost\" is 0.00 at_most.",
          "properties" : {
            "amount" : {
              "description" : "The amount in USD, such as \"15.00\"",
              "type" : "string"
            },
            "comparison" : {
              "description" : "under: the cost must be less than the amount. at_most: it may equal it.",
              "enum" : [ "under", "at_most" ],
              "type" : "string"
            }
          },
          "required" : [ "amount", "comparison" ],
          "type" : "object"
        },
        "deliverBy" : {
          "description" : "The latest acceptable arrival date, YYYY-MM-DD. Arriving on that date counts as on time.",
          "type" : "string"
        },
        "itemDescription" : {
          "description" : "The item the customer has now, in their words, such as \"medium dog harness\"",
          "type" : "string"
        },
        "orderReference" : {
          "description" : "The order reference, such as 1042",
          "type" : "string"
        },
        "quantity" : {
          "description" : "How many units to exchange. Defaults to 1.",
          "format" : "int32",
          "type" : "integer"
        },
        "replacementColor" : {
          "description" : "The color they want instead, such as \"red\". Leave out to keep the current color.",
          "type" : "string"
        },
        "replacementSize" : {
          "description" : "The size they want instead, such as \"large\", \"XL\", or \"42 in\". Leave out to keep the current size.",
          "type" : "string"
        }
      },
      "required" : [ "orderReference", "itemDescription" ],
      "type" : "object"
    },
    "outputSchema" : {
      "$defs" : {
        "Item" : {
          "properties" : {
            "color" : {
              "type" : "string"
            },
            "itemId" : {
              "type" : "string"
            },
            "product" : {
              "type" : "string"
            },
            "quantity" : {
              "format" : "int32",
              "type" : "integer"
            },
            "size" : {
              "type" : "string"
            },
            "sku" : {
              "type" : "string"
            },
            "unitPrice" : {
              "$ref" : "#/$defs/Money"
            }
          },
          "required" : [ "itemId", "product", "quantity", "sku", "unitPrice" ],
          "type" : "object"
        },
        "Money" : {
          "properties" : {
            "amount" : {
              "type" : "string"
            },
            "currency" : {
              "type" : "string"
            }
          },
          "required" : [ "amount", "currency" ],
          "type" : "object"
        },
        "Replacement" : {
          "properties" : {
            "color" : {
              "type" : "string"
            },
            "price" : {
              "$ref" : "#/$defs/Money"
            },
            "size" : {
              "type" : "string"
            },
            "sku" : {
              "type" : "string"
            }
          },
          "required" : [ "price", "sku" ],
          "type" : "object"
        }
      },
      "$schema" : "https://json-schema.org/draft/2020-12/schema",
      "properties" : {
        "availableVariants" : {
          "items" : {
            "$ref" : "#/$defs/Replacement"
          },
          "type" : "array"
        },
        "blockingReasons" : {
          "description" : "Why no option works: deadline, cost_limit, out_of_stock, or variant_not_found",
          "items" : {
            "type" : "string"
          },
          "type" : "array"
        },
        "candidates" : {
          "description" : "The order's items that fit the description, when it fits more than one or none",
          "items" : {
            "$ref" : "#/$defs/Item"
          },
          "type" : "array"
        },
        "constraints" : {
          "properties" : {
            "costLimit" : {
              "properties" : {
                "amount" : {
                  "description" : "The amount in USD, such as \"15.00\"",
                  "type" : "string"
                },
                "comparison" : {
                  "description" : "under: the cost must be less than the amount. at_most: it may equal it.",
                  "enum" : [ "under", "at_most" ],
                  "type" : "string"
                }
              },
              "required" : [ "amount", "comparison" ],
              "type" : "object"
            },
            "deliverBy" : {
              "format" : "date",
              "type" : "string"
            },
            "quantity" : {
              "format" : "int32",
              "type" : "integer"
            }
          },
          "required" : [ "quantity" ],
          "type" : "object"
        },
        "earliestArrival" : {
          "format" : "date",
          "type" : "string"
        },
        "ineligible" : {
          "properties" : {
            "estimatedDelivery" : {
              "format" : "date",
              "type" : "string"
            },
            "reason" : {
              "type" : "string"
            },
            "reasonCode" : {
              "type" : "string"
            },
            "windowEndedOn" : {
              "format" : "date",
